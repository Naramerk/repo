{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "study_id",
    "terminal_reason",
    "trigger",
    "contributing_reasons",
    "summary",
    "fallback_reason",
    "verdict",
    "tasks",
    "questions",
    "sections",
    "truncated"
  ],
  "properties": {
    "study_id": {"type": "string"},
    "terminal_reason": {
      "enum": [
        "refused",
        "human_timeout",
        "budget",
        "deadline",
        "infeasible",
        "cancelled",
        "completed"
      ]
    },
    "trigger": {
      "enum": ["cancel", "budget", "deadline", "all_done", "intake"]
    },
    "contributing_reasons": {
      "type": "array",
      "items": {"type": "string"},
      "maxItems": 20
    },
    "summary": {"type": "string", "maxLength": 1000},
    "question_count": {"type": "integer", "minimum": 0},
    "not_attempted_count": {"type": "integer", "minimum": 0},
    "fallback_reason": {"type": ["string", "null"], "maxLength": 200},
    "refusal": {"type": ["string", "null"]},
    "verdict": {"enum": ["fulfilled", "partial", "stubbed", "failed"]},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_key", "kind", "outcome", "reason", "provenance"],
        "properties": {
          "task_key": {"type": "string"},
          "kind": {"type": "string"},
          "outcome": {"enum": ["SUCCESS", "PARTIAL", "FAILED", "SKIPPED"]},
          "reason": {"type": ["string", "null"]},
          "provenance": {"enum": ["real", "partial", "stub"]}
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_id", "formulation", "disposition", "reason"],
        "properties": {
          "question_id": {"type": "string"},
          "formulation": {"type": "string", "maxLength": 500},
          "disposition": {
            "enum": [
              "answered",
              "refuted",
              "survived",
              "inconclusive",
              "needs_more_data",
              "infeasible",
              "ill_posed",
              "not_attempted"
            ]
          },
          "reason": {"type": "string", "maxLength": 200}
        }
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["real", "stub", "human"],
      "properties": {
        "real": {"type": "array", "items": {"type": "string"}},
        "stub": {"type": "array", "items": {"type": "string"}},
        "human": {"type": "array", "items": {"type": "string"}}
      }
    },
    "truncated": {"type": "boolean"}
  }
}
