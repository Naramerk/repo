{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coscientist/schema/study_refused.schema.json",
  "title": "StudyRefused",
  "description": "Payload of StudyRefused (intake refusal, same txn as StudyCreated).",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "reason", "classifier_error"],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "safety",
        "out_of_scope",
        "empty_request",
        "unsupported_output",
        "budget_zero",
        "contradictory",
        "egress_policy",
        "input_too_large",
        "input_invalid",
        "duration_too_short"
      ]
    },
    "reason": {"type": "string", "maxLength": 200},
    "classifier_error": {"type": "boolean"}
  }
}
